          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_2" source="act_pg_a1" target="act_pg_s1" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_3" source="act_pg_s1" target="act_pg_a2" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_4" source="act_pg_a2" target="act_pg_s2" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_5" source="act_pg_s2" target="act_pg_a3" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_6" source="act_pg_a3" target="act_pg_s3" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_7" source="act_pg_s3" target="act_pg_dec" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_8" source="act_pg_dec" target="act_pg_s4" name="ya"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_9" source="act_pg_dec" target="act_pg_err" name="tidak"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_10" source="act_pg_s4" target="act_pg_s5" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_11" source="act_pg_s5" target="act_pg_a4" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_12" source="act_pg_a4" target="act_pg_fin" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_PENGGUNA_13" source="act_pg_err" target="act_pg_fin" name=""/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" name="Gambar 3.5 Activity Diagram Kelola Data Karyawan" xmi:id="ACT_KARYAWAN">
          <node xmi:type="uml:InitialNode" name="Start" xmi:id="act_kr_init"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih menu Data Karyawan" xmi:id="act_kr_a1"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan daftar karyawan" xmi:id="act_kr_s1"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih aksi: tambah, ubah, hapus" xmi:id="act_kr_a2"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan form isian atau konfirmasi hapus" xmi:id="act_kr_s2"/>
          <node xmi:type="uml:OpaqueAction" name="Mengisi form atau mengonfirmasi hapus" xmi:id="act_kr_a3"/>
          <node xmi:type="uml:OpaqueAction" name="Memvalidasi data" xmi:id="act_kr_s3"/>
          <node xmi:type="uml:DecisionNode" name="Data valid?" xmi:id="act_kr_dec"/>
