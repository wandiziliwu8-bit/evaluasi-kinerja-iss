<?xml version="1.0" encoding="utf-8"?>
<xmi:XMI xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmi:version="2.1">
  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
  <uml:Model xmi:type="uml:Model" name="EA_Model" xmi:id="EAID_MODEL_ROOT">
    <packagedElement xmi:type="uml:Package" name="Sistem Informasi Penilaian Kinerja PT ISS" xmi:id="PKG_PT_ISS">
      <packagedElement xmi:type="uml:Package" name="01 Use Case Model" xmi:id="PKG_USE_CASE">
        <packagedElement xmi:type="uml:Actor" name="Admin" xmi:id="ACT_ADMIN"/>
        <packagedElement xmi:type="uml:Actor" name="Supervisor (SPV)" xmi:id="ACT_SPV"/>
        <packagedElement xmi:type="uml:Actor" name="Karyawan" xmi:id="ACT_KARYAWAN"/>
        <packagedElement xmi:type="uml:UseCase" name="Login" xmi:id="UC_UC1"/>
        <packagedElement xmi:type="uml:UseCase" name="Kelola Data Pengguna" xmi:id="UC_UC2"/>
        <packagedElement xmi:type="uml:UseCase" name="Kelola Data Karyawan" xmi:id="UC_UC3"/>
        <packagedElement xmi:type="uml:UseCase" name="Kelola Data Master (Area, Etika, Alat, SOP)" xmi:id="UC_UC4"/>
        <packagedElement xmi:type="uml:UseCase" name="Kelola Skala, Bobot, dan Kategori Nilai" xmi:id="UC_UC5"/>
        <packagedElement xmi:type="uml:UseCase" name="Kelola Periode Penilaian" xmi:id="UC_UC6"/>
        <packagedElement xmi:type="uml:UseCase" name="Input Penilaian Kinerja" xmi:id="UC_UC7">
          <include xmi:type="uml:Include" xmi:id="INC_HITUNG" addition="UC_UC12"/>
          <include xmi:type="uml:Include" xmi:id="INC_ETIKA" addition="UC_UC7_1"/>
          <include xmi:type="uml:Include" xmi:id="INC_ALAT" addition="UC_UC7_2"/>
          <include xmi:type="uml:Include" xmi:id="INC_SOP" addition="UC_UC7_3"/>
          <include xmi:type="uml:Include" xmi:id="INC_ATASAN" addition="UC_UC7_4"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" name="Lihat Rekap dan Laporan Penilaian" xmi:id="UC_UC8"/>
        <packagedElement xmi:type="uml:UseCase" name="Cetak / Ekspor Laporan" xmi:id="UC_UC9">
          <extend xmi:type="uml:Extend" xmi:id="EXT_CETAK" extendedCase="UC_UC8"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" name="Lihat Hasil Penilaian" xmi:id="UC_UC10"/>
        <packagedElement xmi:type="uml:UseCase" name="Beri Tanggapan (Feedback)" xmi:id="UC_UC11">
          <extend xmi:type="uml:Extend" xmi:id="EXT_TANGGAP" extendedCase="UC_UC10"/>
        </packagedElement>
        <packagedElement xmi:type="uml:UseCase" name="Hitung Nilai Otomatis" xmi:id="UC_UC12"/>
        <packagedElement xmi:type="uml:UseCase" name="Finalisasi Penilaian" xmi:id="UC_UC13"/>
        <packagedElement xmi:type="uml:UseCase" name="Isi Evaluasi Etika Kerja (10 aspek)" xmi:id="UC_UC7_1"/>
        <packagedElement xmi:type="uml:UseCase" name="Isi Evaluasi Pengetahuan Alat Kerja" xmi:id="UC_UC7_2"/>
        <packagedElement xmi:type="uml:UseCase" name="Isi Evaluasi Penerapan SOP" xmi:id="UC_UC7_3"/>
        <packagedElement xmi:type="uml:UseCase" name="Isi Tanggapan dan Rekomendasi Atasan" xmi:id="UC_UC7_4"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" name="02 Activity Model" xmi:id="PKG_ACTIVITY_MODEL">
        <packagedElement xmi:type="uml:Activity" name="Gambar 3.3 Activity Diagram Login" xmi:id="ACT_LOGIN">
          <node xmi:type="uml:InitialNode" name="Start" xmi:id="act_lg_init"/>
          <node xmi:type="uml:OpaqueAction" name="Membuka halaman login" xmi:id="act_lg_a1"/>
          <node xmi:type="uml:OpaqueAction" name="Mengisi username dan password" xmi:id="act_lg_a2"/>
          <node xmi:type="uml:OpaqueAction" name="Menekan tombol Login" xmi:id="act_lg_a3"/>
          <node xmi:type="uml:OpaqueAction" name="Memvalidasi username dan password" xmi:id="act_lg_s1"/>
          <node xmi:type="uml:DecisionNode" name="Data valid?" xmi:id="act_lg_dec"/>
          <node xmi:type="uml:OpaqueAction" name="Menentukan hak akses" xmi:id="act_lg_s2"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan dashboard sesuai peran" xmi:id="act_lg_s3"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat dashboard" xmi:id="act_lg_a4"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat pesan kesalahan login" xmi:id="act_lg_err"/>
          <node xmi:type="uml:ActivityFinalNode" name="End" xmi:id="act_lg_fin"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_1" source="act_lg_init" target="act_lg_a1" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_2" source="act_lg_a1" target="act_lg_a2" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_3" source="act_lg_a2" target="act_lg_a3" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_4" source="act_lg_a3" target="act_lg_s1" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_5" source="act_lg_s1" target="act_lg_dec" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_6" source="act_lg_dec" target="act_lg_s2" name="ya"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_7" source="act_lg_dec" target="act_lg_err" name="tidak"/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_8" source="act_lg_s2" target="act_lg_s3" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_9" source="act_lg_s3" target="act_lg_a4" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_10" source="act_lg_a4" target="act_lg_fin" name=""/>
          <edge xmi:type="uml:ControlFlow" xmi:id="FLOW_ACT_LOGIN_11" source="act_lg_err" target="act_lg_fin" name=""/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" name="Gambar 3.4 Activity Diagram Kelola Data Pengguna" xmi:id="ACT_PENGGUNA">
          <node xmi:type="uml:InitialNode" name="Start" xmi:id="act_pg_init"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih menu Data Pengguna" xmi:id="act_pg_a1"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan daftar akun pengguna" xmi:id="act_pg_s1"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih aksi: tambah, ubah, nonaktifkan" xmi:id="act_pg_a2"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan formulir kelola akun" xmi:id="act_pg_s2"/>
          <node xmi:type="uml:OpaqueAction" name="Mengisi form akun dan klik Simpan" xmi:id="act_pg_a3"/>
          <node xmi:type="uml:OpaqueAction" name="Memvalidasi keunikan username dan data" xmi:id="act_pg_s3"/>
          <node xmi:type="uml:DecisionNode" name="Data valid?" xmi:id="act_pg_dec"/>
          <node xmi:type="uml:OpaqueAction" name="Menyimpan perubahan data akun ke database" xmi:id="act_pg_s4"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan pesan sukses &amp; refresh tabel" xmi:id="act_pg_s5"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat daftar pengguna terbaru" xmi:id="act_pg_a4"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat pesan kesalahan validasi" xmi:id="act_pg_err"/>
          <node xmi:type="uml:ActivityFinalNode" name="End" xmi:id="act_pg_fin"/>
