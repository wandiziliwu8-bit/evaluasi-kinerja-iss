          <node xmi:type="uml:OpaqueAction" name="Menampilkan pesan berhasil dan daftar terbaru" xmi:id="act_kr_s5"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat daftar terbaru" xmi:id="act_kr_a4"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat pesan kesalahan" xmi:id="act_kr_err"/>
          <node xmi:type="uml:ActivityFinalNode" name="End" xmi:id="act_kr_fin"/>
