      <packagedElement xmi:type="uml:Package" name="05 Sequence Model" xmi:id="PKG_SEQUENCE_MODEL">
        <packagedElement xmi:type="uml:Collaboration" name="Collab_SEQ_LOGIN" xmi:id="COL_SEQ_LOGIN">
          <ownedBehavior xmi:type="uml:Interaction" name="Gambar 3.10 Sequence Diagram Login" xmi:id="INT_SEQ_LOGIN">
            <lifeline xmi:type="uml:Lifeline" name="Pengguna" xmi:id="SEQ_LOGIN_LF_AKTOR"/>
            <lifeline xmi:type="uml:Lifeline" name="Halaman (View)" xmi:id="SEQ_LOGIN_LF_VIEW"/>
