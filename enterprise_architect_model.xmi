        <packagedElement xmi:type="uml:Activity" name="Gambar 3.8 Activity Diagram Kelola Periode Penilaian" xmi:id="ACT_PERIODE">
          <node xmi:type="uml:InitialNode" name="Start" xmi:id="act_pr_init"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih menu Periode Penilaian" xmi:id="act_pr_a1"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan histori &amp; status periode" xmi:id="act_pr_s1"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih aksi: buka, ubah, tutup" xmi:id="act_pr_a2"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan form isian periode" xmi:id="act_pr_s2"/>
          <node xmi:type="uml:OpaqueAction" name="Mengisi jadwal &amp; klik Simpan" xmi:id="act_pr_a3"/>
          <node xmi:type="uml:OpaqueAction" name="Memvalidasi aturan periode aktif tunggal" xmi:id="act_pr_s3"/>
          <node xmi:type="uml:DecisionNode" name="Validasi sesuai?" xmi:id="act_pr_dec"/>
