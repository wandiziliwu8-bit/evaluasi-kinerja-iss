        </packagedElement>
        <packagedElement xmi:type="uml:Activity" name="Gambar 3.7 Activity Diagram Kelola Skala, Bobot &amp; Kategori" xmi:id="ACT_SKALA">
          <node xmi:type="uml:InitialNode" name="Start" xmi:id="act_sk_init"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih menu Skala &amp; Bobot Nilai" xmi:id="act_sk_a1"/>
