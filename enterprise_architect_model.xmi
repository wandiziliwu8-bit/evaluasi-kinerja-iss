        </packagedElement>
        <packagedElement xmi:type="uml:Activity" name="Gambar 3.6 Activity Diagram Kelola Data Master" xmi:id="ACT_MASTER">
          <node xmi:type="uml:InitialNode" name="Start" xmi:id="act_ms_init"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih menu Data Master &amp; tab kategori" xmi:id="act_ms_a1"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan item master sesuai tab" xmi:id="act_ms_s1"/>
          <node xmi:type="uml:OpaqueAction" name="Memilih aksi: tambah, edit, hapus" xmi:id="act_ms_a2"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan modal form item master" xmi:id="act_ms_s2"/>
          <node xmi:type="uml:OpaqueAction" name="Mengisi detail item master &amp; klik Simpan" xmi:id="act_ms_a3"/>
          <node xmi:type="uml:OpaqueAction" name="Memvalidasi isian data master" xmi:id="act_ms_s3"/>
          <node xmi:type="uml:DecisionNode" name="Data valid?" xmi:id="act_ms_dec"/>
          <node xmi:type="uml:OpaqueAction" name="Menyimpan ke tabel master database" xmi:id="act_ms_s4"/>
          <node xmi:type="uml:OpaqueAction" name="Menampilkan pesan sukses &amp; refresh daftar" xmi:id="act_ms_s5"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat data master terbaru" xmi:id="act_ms_a4"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat pesan kesalahan input" xmi:id="act_ms_err"/>
          <node xmi:type="uml:ActivityFinalNode" name="End" xmi:id="act_ms_fin"/>
