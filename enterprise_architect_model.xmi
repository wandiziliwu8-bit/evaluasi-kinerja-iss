            <message xmi:type="uml:Message" name="data pengguna" xmi:id="SEQ_LOGIN_M_6" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="verifikasi password (hash)" xmi:id="SEQ_LOGIN_M_7" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="redirect dashboard sesuai role" xmi:id="SEQ_LOGIN_M_8" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="Menampilkan dashboard" xmi:id="SEQ_LOGIN_M_9" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="pesan kesalahan" xmi:id="SEQ_LOGIN_M_10" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="Menampilkan pesan login gagal" xmi:id="SEQ_LOGIN_M_11" messageSort="synchCall"/>
          </ownedBehavior>
        </packagedElement>
        <packagedElement xmi:type="uml:Collaboration" name="Collab_SEQ_KARYAWAN" xmi:id="COL_SEQ_KARYAWAN">
          <ownedBehavior xmi:type="uml:Interaction" name="Gambar 3.11 Sequence Diagram Kelola Data Karyawan" xmi:id="INT_SEQ_KARYAWAN">
