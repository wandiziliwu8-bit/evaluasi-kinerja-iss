            <message xmi:type="uml:Message" name="Menampilkan daftar terbaru" xmi:id="SEQ_KARYAWAN_M_17" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="pesan kesalahan validasi" xmi:id="SEQ_KARYAWAN_M_18" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="Menampilkan pesan kesalahan" xmi:id="SEQ_KARYAWAN_M_19" messageSort="synchCall"/>
          </ownedBehavior>
        </packagedElement>
        <packagedElement xmi:type="uml:Collaboration" name="Collab_SEQ_PENILAIAN" xmi:id="COL_SEQ_PENILAIAN">
          <ownedBehavior xmi:type="uml:Interaction" name="Gambar 3.12 Sequence Diagram Input Penilaian Kinerja" xmi:id="INT_SEQ_PENILAIAN">
            <lifeline xmi:type="uml:Lifeline" name="Supervisor (SPV)" xmi:id="SEQ_PENILAIAN_LF_AKTOR"/>
