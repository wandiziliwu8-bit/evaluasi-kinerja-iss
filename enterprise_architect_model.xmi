            <message xmi:type="uml:Message" name="Mengisi penilaian lalu Simpan" xmi:id="SEQ_PENILAIAN_M_9" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="simpan(data)" xmi:id="SEQ_PENILAIAN_M_10" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="validasi kelengkapan isian" xmi:id="SEQ_PENILAIAN_M_11" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="hitungNilai(), tentukanKategori()" xmi:id="SEQ_PENILAIAN_M_12" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="INSERT penilaian, detail_etika, detail_alat, detail_sop" xmi:id="SEQ_PENILAIAN_M_13" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="INSERT INTO penilaian..." xmi:id="SEQ_PENILAIAN_M_14" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="berhasil" xmi:id="SEQ_PENILAIAN_M_15" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="nilai akhir dan kategori" xmi:id="SEQ_PENILAIAN_M_16" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="hasil penilaian (status draft)" xmi:id="SEQ_PENILAIAN_M_17" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="Menampilkan nilai dan kategori" xmi:id="SEQ_PENILAIAN_M_18" messageSort="synchCall"/>
