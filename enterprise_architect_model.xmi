            <message xmi:type="uml:Message" name="Menampilkan pesan kesalahan" xmi:id="SEQ_FEEDBACK_M_19" messageSort="synchCall"/>
          </ownedBehavior>
        </packagedElement>
        <packagedElement xmi:type="uml:Collaboration" name="Collab_SEQ_LAPORAN" xmi:id="COL_SEQ_LAPORAN">
          <ownedBehavior xmi:type="uml:Interaction" name="Gambar 3.15 Sequence Diagram Rekap dan Cetak Laporan" xmi:id="INT_SEQ_LAPORAN">
