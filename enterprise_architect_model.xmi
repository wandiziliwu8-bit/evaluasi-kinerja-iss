            <lifeline xmi:type="uml:Lifeline" name="Database (MySQL)" xmi:id="SEQ_LOGIN_LF_DB"/>
            <message xmi:type="uml:Message" name="Mengisi username dan password" xmi:id="SEQ_LOGIN_M_1" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="login(username, password)" xmi:id="SEQ_LOGIN_M_2" messageSort="synchCall"/>
            <message xmi:type="uml:Message" name="cariPengguna(username)" xmi:id="SEQ_LOGIN_M_3" messageSort="synchCall"/>
