          <node xmi:type="uml:OpaqueAction" name="Menampilkan notifikasi sukses &amp; refresh" xmi:id="act_pr_s5"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat status periode terbaru" xmi:id="act_pr_a4"/>
          <node xmi:type="uml:OpaqueAction" name="Melihat pesan kesalahan tanggal" xmi:id="act_pr_err"/>
          <node xmi:type="uml:ActivityFinalNode" name="End" xmi:id="act_pr_fin"/>
